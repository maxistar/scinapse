# Optional: enables backend-only Nebius relevance assessments.
NEBIUS_API_KEY=
# Optional: Semantic Scholar key for improved rate limits.
S2_API_KEY=
# Quick local profile. Set to 0 for standard expansion.
SCINAPSE_SMOKE=1
# Set to 1 to skip LLM assessments even when a key is present.
SCINAPSE_NO_LLM=0
# Optional polite-pool contact identifier for external API requests.
# SCINAPSE_MAILTO=you@example.com
# Optional: enables the Tavily web-search entry (skipped with a warning when absent).
TAVILY_API_KEY=
